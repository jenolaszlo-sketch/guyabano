// Minimal pilot reproducing Guyabano's hard-coded CodeGenerationWorkflow
// sequential spine: ctx -> plan (infer) -> scaffold (activity) -> build (activity)
// This is the DSL surface that compiles to the same sequential IR
// the programmatic builder below produces. Fan-out/loop waves are programmatic
// only until fuwen-grammar adds fanout.
workflow codegenPilot(input: string) -> string {
  context ctx = context "guyabano.context@1#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" (request: input;) -> string;
  infer plan = infer "guyabano.plan-profile@1#bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" using "guyabano.plan-template@1#cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" (request: ctx;) with ctx -> string;
  activity scaffold = activity "guyabano.scaffold@1#dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" (plan: plan;) -> string;
  activity build = activity "guyabano.build@1#eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" (artifact: scaffold;) -> string;
  return build;
}
